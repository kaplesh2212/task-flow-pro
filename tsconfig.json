{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "baseUrl": ".",
    "paths": {
      "@workspace/api-zod": ["lib/api-zod/src/index.ts"],
      "@workspace/db": ["lib/db/src/index.ts"],
      "@workspace/api-server": ["artifacts/api-server/src/app.ts"],
      "@workspace/*": ["artifacts/*", "lib/*"]
    }
  },
  "include": ["api/**/*.ts", "artifacts/api-server/**/*.ts", "lib/**/*.ts"]
}
